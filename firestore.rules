rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{roomId} {
      allow read, create, update: if true;
      match /players/{playerId} {
        allow read, create, update: if true;
      }
      match /privateRoles/{playerId} {
        allow read, create, update: if true;
      }
      match /votes/{playerId} {
        allow read, create, update: if true;
      }
    }
  }
}